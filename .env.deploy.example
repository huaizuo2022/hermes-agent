# deploy-hermes.sh 部署凭证模板
#
# 用法：复制本文件为 .env.deploy 并填入真实值
#   cp .env.deploy.example .env.deploy
#   # 编辑 .env.deploy 填入真实密码与 API key
#
# .env.deploy 已被 .gitignore 忽略，不会进入版本控制。

# 远端服务器 SSH 密码（146.56.229.151 root 用户，密码登录）
HERMES_REMOTE_PASSWORD="your-ssh-password-here"

# DeepSeek API key（写入远端 systemd unit + crontab 环境变量）
DEEPSEEK_API_KEY="sk-your-deepseek-key-here"